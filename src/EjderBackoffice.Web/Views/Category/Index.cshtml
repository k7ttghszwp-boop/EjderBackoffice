@model IEnumerable<Ejder.Application.Categories.DTOs.CategoryDto>
@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_LayoutBackoffice";
}

<div class="ej-page-title">
    <div>
        <h1 class="fw-semibold">Kategori Yönetimi</h1>
        <div class="ej-page-subtitle d-none d-md-block">CATEGORY_INDEX // CLASSIFICATION_MATRIX</div>
    </div>
    <div>
        <a asp-action="Create" class="btn ej-btn-primary btn-sm d-flex align-items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            <span>Yeni Kategori Ekle</span>
        </a>
    </div>
</div>

<div class="ej-table-card">
    <div class="ej-table-title-row">
        <div class="ej-table-title">
            <i class="fa-solid fa-layer-group me-2"></i>Kategori Listesi
        </div>
        <div class="ej-table-actions">
            <span class="badge bg-primary bg-opacity-10 text-primary d-none d-md-inline">CATEGORY_INDEX // CLASSIFICATION_MATRIX</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle ej-data-table js-ej-datatable">
            <thead>
                <tr>
                    <th>Adı (TR)</th>
                    <th>Adı (EN)</th>
                    <th>Durum</th>
                    <th>Oluşturulma</th>
                    <th class="text-center">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr id="row-@item.Id">
                        <td><strong>@item.Name_TR</strong></td>
                        <td>@item.Name_EN</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="ej-badge-status active">[ACTIVE]</span>
                            }
                            else
                            {
                                <span class="ej-badge-status passive">[PASSIVE]</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-center">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-outline-danger js-ej-delete"
                                        data-delete-url="/Category/Delete/@item.Id"
                                        data-row-id="row-@item.Id">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- DataTables ve silme işlemleri global ejder-app.js ile yönetilir. -->
}
