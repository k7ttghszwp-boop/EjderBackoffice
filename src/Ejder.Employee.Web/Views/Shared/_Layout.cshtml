<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - EJDER CORE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-primary: #000;
            --text-primary: #fff;
            --border: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.8) !important;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -1px;
            text-transform: uppercase;
        }

        .badge-soft {
            background: rgba(255, 255, 255, 0.05);
            color: #fff;
            border: 1px solid var(--border);
            border-radius: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.7rem;
        }

        .card {
            background: #0a0a0a;
            border: 1px solid var(--border);
            border-radius: 0;
        }

        .fade-in {
            animation: fadeIn 1s ease forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .btn-outline-light {
            border-radius: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            font-size: 0.8rem;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body class="bg-black">

<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">
        <a class="navbar-brand" href="@Url.Action("Dashboard","Portal")">EJDER CORE</a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="nav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link text-uppercase tracking-widest small" href="@Url.Action("Dashboard","Portal")">Overview</a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-4">
                <div class="d-flex flex-column align-items-end">
                    <span class="small opacity-50 text-uppercase tracking-widest" style="font-size: 8px;">ACTIVE_OPERATOR</span>
                    <span class="fw-bold">@((Context.Session.GetString("EmployeeName") ?? "GUEST"))</span>
                </div>

                <a class="btn btn-outline-light btn-sm" href="@Url.Action("Logout","Portal")">Terminate</a>
            </div>
        </div>
    </div>
</nav>

<main class="container my-5 fade-in">
    @RenderBody()
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
