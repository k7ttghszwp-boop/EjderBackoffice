@using Ejder.Domain.HR
@model IEnumerable<Employee>

<h1>Personel Listesi</h1>

<table>
    <tr>
        <th>Ad Soyad</th>
        <th>Departman</th>
        <th>Rol</th>
        <th>Rapor Verdiği</th>
    </tr>

@foreach (var e in Model)
{
    var departments = ViewBag.Departments as IEnumerable<Department>;
    var dept = departments?.FirstOrDefault(x => x.Id == e.DepartmentId);
    var manager = e.ReportsToEmployeeId.HasValue
        ? Model.FirstOrDefault(x => x.Id == e.ReportsToEmployeeId.Value)
        : null;

    <tr>
        <td>@e.FullName</td>
        <td>@dept?.Name</td>
        <td>@e.Role</td>
        <td>@(manager?.FullName ?? "-")</td>
    </tr>
}
</table>
