@using Ejder.Domain.HR
@{
    ViewData["Title"] = "MANAGEMENT_CONTROL";
    Layout = "_Layout";

    var list = ViewBag.TodayAll as List<Attendance> ?? new List<Attendance>();

    int total = list.Count;
    int inside = list.Count(x => x.CheckIn != null && x.CheckOut == null);
    int done = list.Count(x => x.CheckIn != null && x.CheckOut != null);
}

<div class="d-flex align-items-end justify-content-between mb-5 border-bottom border-secondary border-opacity-25 pb-4">
    <div>
        <h1 class="display-5 fw-bold tracking-tight m-0">OPERATIONAL_OVERVIEW</h1>
        <div class="small text-muted tracking-widest mt-2">REAL-TIME PERSONNEL LOGISTICS // @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</div>
    </div>
    <div class="text-end">
        <span class="badge border border-white text-white px-3 py-2 rounded-0 small tracking-widest">LIVE_CONNECTION_SECURED</span>
    </div>
</div>

<div class="row g-0 mb-5 border border-secondary border-opacity-25">
    <div class="col-12 col-md-4 border-end border-secondary border-opacity-25">
        <div class="p-5">
            <div class="small text-muted text-uppercase tracking-widest mb-3">Total Logs</div>
            <div class="display-3 fw-bold">@total.ToString("00")</div>
        </div>
    </div>

    <div class="col-12 col-md-4 border-end border-secondary border-opacity-25">
        <div class="p-5">
            <div class="small text-muted text-uppercase tracking-widest mb-3">Active On-Site</div>
            <div class="display-3 fw-bold">@inside.ToString("00")</div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="p-5">
            <div class="small text-muted text-uppercase tracking-widest mb-3">Terminated Cycles</div>
            <div class="display-3 fw-bold">@done.ToString("00")</div>
        </div>
    </div>
</div>

<div class="card bg-black border border-secondary border-opacity-25 rounded-0">
    <div class="card-header bg-white text-black rounded-0 border-0 p-3">
        <div class="fw-bold text-uppercase tracking-widest small">ACTIVITY_STREAM</div>
    </div>
    <div class="card-body p-0">
        @if (!list.Any())
        {
            <div class="p-5 text-center text-muted opacity-50 tracking-widest">NO_DATA_MATCHES_CURRENT_QUERY</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover m-0 align-middle">
                    <thead>
                        <tr class="bg-dark bg-opacity-50">
                            <th class="ps-4 py-3">ID</th>
                            <th class="py-3">OPERATOR_IDENTITY</th>
                            <th class="py-3">INITIALIZED</th>
                            <th class="py-3">TERMINATED</th>
                            <th class="py-3 pe-4 text-end">STATUS_FLAG</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in list.OrderByDescending(x => x.CheckIn))
                    {
                        var inText = item.CheckIn is DateTime ci ? ci.ToString("HH:mm") : "00:00";
                        var outText = item.CheckOut.HasValue ? item.CheckOut.Value.ToString("HH:mm") : "----";

                        var isInside = item.CheckOut == null;
                        var status = isInside ? "ACTIVE" : "COMPLETED";
                        var statusClass = isInside ? "text-white" : "text-muted";

                        <tr>
                            <td class="ps-4 fw-mono opacity-50">#@item.EmployeeId.ToString("000")</td>
                            <td>
                                <div class="fw-bold">
                                    @{
                                        var employees = ViewBag.Employees as List<Employee> ?? new List<Employee>();
                                        var emp = employees.FirstOrDefault(x => x.Id == item.EmployeeId);
                                        var fullName = emp?.FullName ?? $"NODE_{item.EmployeeId}";
                                    }
                                    @fullName.ToUpper()
                                </div>
                                @if (emp?.Role != null)
                                {
                                    <div class="small text-muted tracking-widest" style="font-size: 9px;">@emp.Role.ToUpper()</div>
                                }
                            </td>
                            <td class="fw-mono">@inText</td>
                            <td class="fw-mono">@outText</td>
                            <td class="pe-4 text-end">
                                <span class="fw-bold tracking-widest @statusClass">[@status]</span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .fw-mono { font-family: 'Courier New', Courier, monospace; }
    .display-3 { letter-spacing: -4px; }
    .table-dark { background-color: transparent !important; }
    .table-hover tbody tr:hover { background-color: rgba(255,255,255,0.02) !important; }
</style>
