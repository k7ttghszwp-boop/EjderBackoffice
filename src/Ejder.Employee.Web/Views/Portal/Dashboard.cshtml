@using Ejder.Domain.HR
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var name = (string?)ViewBag.EmployeeName ?? "Personel";
    Attendance? today = ViewBag.Today as Attendance;

    DateTime? checkIn = today?.CheckIn;
    DateTime? checkOut = today?.CheckOut;

    string checkInText = checkIn.HasValue ? checkIn.Value.ToString("HH:mm") : "Henüz yok";
    string checkOutText = checkOut.HasValue ? checkOut.Value.ToString("HH:mm") : "Henüz yok";

    string status =
        (checkIn.HasValue && !checkOut.HasValue) ? "İçeride" :
        (checkIn.HasValue && checkOut.HasValue) ? "Çıkış yaptı" :
        "Beklemede";

    bool canCheckIn = !checkIn.HasValue;
    bool canCheckOut = checkIn.HasValue && !checkOut.HasValue;
}

<div class="d-flex align-items-start justify-content-between flex-wrap gap-2">
    <div>
        <h3 class="mb-1">Hoş geldin, @name 👋</h3>
        <div class="text-muted">
            Bugünkü giriş / çıkış durumun
        </div>
    </div>

    <span class="badge badge-soft px-3 py-2">
        Durum: <strong>@status</strong>
    </span>
</div>

<div class="row g-3 mt-3">
    <div class="col-12 col-md-4">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">📅 Tarih</div>
                <div class="fs-5 fw-semibold">@DateTime.Today.ToString("dd.MM.yyyy")</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">🟢 Giriş Saati</div>
                <div class="fs-3 fw-bold">@checkInText</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card shadow-soft">
            <div class="card-body">
                <div class="text-muted small">🔴 Çıkış Saati</div>
                <div class="fs-3 fw-bold">@checkOutText</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-soft mt-4">
    <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <div>
            <div class="fw-semibold">Hızlı İşlemler</div>
            <div class="text-muted small">
                Giriş ve çıkış işlemlerini buradan yapabilirsin
            </div>
        </div>

        <div class="d-flex gap-2">
            <form method="post" asp-controller="Portal" asp-action="CheckIn">
                <button type="submit"
                        class="btn btn-success"
                        @(canCheckIn ? "" : "disabled")>
                    Giriş Yap
                </button>
            </form>

            <form method="post" asp-controller="Portal" asp-action="CheckOut">
                <button type="submit"
                        class="btn btn-danger"
                        @(canCheckOut ? "" : "disabled")>
                    Çıkış Yap
                </button>
            </form>
        </div>
    </div>
</div>

@if (today == null)
{
    <div class="alert alert-info mt-3">
        Bugün için henüz giriş yapılmadı.
    </div>
}
