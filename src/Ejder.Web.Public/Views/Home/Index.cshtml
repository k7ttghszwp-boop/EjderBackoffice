@model List<Ejder.Application.Tours.DTOs.TourListDto>
@{
    ViewData["Title"] = "Ucuz Oteller, Tatil Turları ve Uçak Biletleri";
    Layout = "_Layout";
}

<section class="hero-travel">
    <div class="container" style="z-index: 10;">
        <h1 class="hero-title">Hayalindeki tatili Ejder ile planla!</h1>
        
        <div class="search-widget">
            <div class="search-tabs">
                <div class="search-tab active"><i class="bi bi-building"></i> Otel</div>
                <div class="search-tab"><i class="bi bi-geo-alt"></i> Tur</div>
                <div class="search-tab"><i class="bi bi-airplane"></i> Uçak</div>
                <div class="search-tab"><i class="bi bi-house"></i> Villa</div>
            </div>
            
            <form action="/tr/tours" method="get">
                <div class="search-inputs">
                    <div class="search-input-group" style="flex: 2;">
                        <label>Nereye, Hangi Otele veya Neye Bakıyorsunuz?</label>
                        <input type="text" name="q" placeholder="Nereye gitmek istersin?" required />
                    </div>
                    <div class="search-input-group">
                        <label>Tarih Seçin</label>
                        <input type="text" placeholder="Giriş - Çıkış Tarihi" />
                    </div>
                    <div class="search-input-group">
                        <label>Misafir</label>
                        <input type="text" placeholder="2 Misafir, 1 Oda" value="2 Yetişkin" />
                    </div>
                    <div class="search-input-group">
                        <button type="submit" class="btn-search"><i class="bi bi-search"></i></button>
                    </div>
                </div>
            </form>
        </div>
        
        <div class="popular-searches">
            <span class="text-white opacity-75">Popüler Aramalar:</span> 
            <a href="#">2026 Erken Rezervasyon Otelleri</a> 
            <a href="#">Termal Oteller</a> 
            <a href="#">Kıbrıs Otelleri</a>
        </div>
    </div>
</section>

<!-- Popüler Turlar -->
<section class="container py-5 mt-4">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h3 class="fw-bold mb-1">Popüler Turlar</h3>
            <p class="text-muted mb-0">En çok tercih edilen, unutulmaz rotalar.</p>
        </div>
        <a href="/tr/tours" class="btn btn-outline-dark rounded-pill px-4 fw-bold">Tümünü Gör</a>
    </div>
    
    <div class="row g-4">
        @foreach (var tour in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden translate-y-hover">
                    <div class="position-relative">
                        <img src="@(string.IsNullOrEmpty(tour.ImageUrl) ? "/images/placeholder-tour.jpg" : tour.ImageUrl)" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@tour.Name_TR">
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge bg-white text-dark shadow-sm rounded-pill px-3 py-2 fw-bold small">
                                @tour.CategoryName_TR
                            </span>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-2">
                             <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i> @tour.StartDate.ToString("dd MMM") - @tour.EndDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <h5 class="fw-bold mb-3">@tour.Name_TR</h5>
                        <p class="text-muted small line-clamp-2 mb-4">@tour.ShortDescription_TR</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <div>
                                @if (tour.DiscountedPrice.HasValue)
                                {
                                    <div class="text-muted text-decoration-line-through small mb-0">@tour.Price.ToString("C0")</div>
                                    <div class="text-primary fw-bold fs-5">@tour.DiscountedPrice.Value.ToString("C0")</div>
                                }
                                else
                                {
                                    <div class="text-primary fw-bold fs-5">@tour.Price.ToString("C0")</div>
                                }
                            </div>
                            <a href="/tr/tours/@tour.Id" class="btn btn-primary rounded-pill px-4 btn-sm fw-bold">İncele</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .translate-y-hover { transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .translate-y-hover:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
<!-- Popular Regions -->
<section class="container py-5 my-5">
    <h3 class="section-title">Popüler Bölgeler</h3>
    
    <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
        <button class="btn dest-filter active">Antalya</button>
        <button class="btn dest-filter">Sapanca</button>
        <button class="btn dest-filter">Alanya</button>
        <button class="btn dest-filter">Kemer</button>
        <button class="btn dest-filter">Kuşadası</button>
        <button class="btn dest-filter">Bodrum</button>
        <button class="btn dest-filter">Marmaris</button>
    </div>

    <!-- Masonry-like Grid -->
    <div class="row g-4">
        <!-- Big Card Left -->
        <div class="col-md-4">
            <a href="/Oteller/Antalya/Belek" class="dest-card h-large">
                <img src="https://images.unsplash.com/photo-1519046904884-53103b34b206?w=800" alt="Belek" />
                <div class="dest-overlay">
                    <h4>Belek</h4>
                    <p>72 Otel</p>
                </div>
            </a>
        </div>
        
        <!-- Center Stack -->
        <div class="col-md-4">
            <div class="row g-4">
                <div class="col-12">
                    <a href="/Oteller/Bodrum" class="dest-card h-small">
                        <img src="https://images.unsplash.com/photo-1582200230678-0eadeac4fdf0?w=800" alt="Bodrum" />
                        <div class="dest-overlay">
                            <h4>Bodrum</h4>
                            <p>350 Otel</p>
                        </div>
                    </a>
                </div>
                <div class="col-12">
                    <a href="/Oteller/Sapanca" class="dest-card h-small">
                        <img src="https://images.unsplash.com/photo-1610444390076-21a4f009cc28?w=800" alt="Sapanca" />
                        <div class="dest-overlay">
                            <h4>Sapanca</h4>
                            <p>496 Otel</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Right Stack -->
        <div class="col-md-4">
            <div class="row g-4">
                <div class="col-12">
                    <a href="/Oteller/Sarm-El-Seyh" class="dest-card h-small">
                        <img src="https://images.unsplash.com/photo-1572978393582-7ad2ec32c25a?w=800" alt="Şarm El-Şeyh" />
                        <div class="dest-overlay">
                            <h4>Şarm El-Şeyh</h4>
                            <p>789 Otel</p>
                        </div>
                    </a>
                </div>
                <div class="col-12">
                    <a href="/Oteller/Cesme" class="dest-card h-small">
                        <img src="https://images.unsplash.com/photo-1499793983690-e29da59ef1c2?w=800" alt="Çeşme" />
                        <div class="dest-overlay">
                            <h4>Çeşme</h4>
                            <p>583 Otel</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="text-center mt-5">
        <button class="btn btn-dark rounded-pill px-5 fw-bold shadow-sm">Tüm Popüler Bölgeleri Gör</button>
    </div>
</section>

<!-- App Section Banner -->
<section class="container mb-5">
    <div class="card border-0 rounded-4" style="background: var(--light-gray); border: 1px solid var(--border-color) !important;">
        <div class="card-body p-lg-5">
            <div class="row align-items-center">
                <div class="col-md-7 ps-lg-4">
                    <h2 class="fw-bold mb-4" style="font-size: 2.5rem; color: #1a1a1a;">Ejder uygulaması ile tatil planı yapmak çok kolay!</h2>
                    <p class="text-muted fs-5 mb-4">Tatil köyünden butik otele, pansiyondan apart otele ve lüks villalara kadar sayısız konaklama seçeneği Ejder'in mobil uygulamasında! Dilerseniz yurt dışı ve cruise turunuzu da uygulamasından kolayca alabilirsiniz.</p>
                </div>
                <div class="col-md-5 text-center">
                    <img src="https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?h=300" alt="Mobile App" class="img-fluid rounded-4 shadow-lg" style="max-height: 250px; object-fit: cover;" />
                </div>
            </div>
        </div>
    </div>
</section>

