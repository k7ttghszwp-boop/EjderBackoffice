<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Ejder Turizm</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">

    @RenderSection("Styles", required: false)
</head>
<body>

<!-- Top Header for Account & Contacts -->
<div class="top-header d-none d-lg-block">
    <div class="container d-flex justify-content-end align-items-center gap-4">
        <div>
            <span class="text-muted"><i class="bi bi-question-circle"></i> Yardım</span>
            <span class="ms-3 text-muted">Acenteler</span>
            <span class="ms-3 fw-bold"><i class="bi bi-telephone"></i> 444 0 387</span>
        </div>
        <div class="d-flex gap-3 border-start ps-4">
            <a href="/Hesabim"><i class="bi bi-person"></i> Hesabım</a>
            <a href="/Rezervasyonlarim"><i class="bi bi-card-list"></i> Rezervasyonlarım</a>
        </div>
    </div>
</div>

<!-- Main Navbar -->
<nav class="navbar navbar-expand-lg sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            ejderturizm <span>| BİZE UYAR</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse rounded-3 p-3 p-lg-0 bg-white" id="nav">
            <ul class="navbar-nav mx-auto align-items-center gap-1 gap-lg-3">
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Otel</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Oteller/Antalya">Antalya Otelleri</a></li>
                        <li><a class="dropdown-item" href="/Oteller/Bodrum">Bodrum Otelleri</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Tur</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Turlar/Yurtici">Yurt İçi Turlar</a></li>
                        <li><a class="dropdown-item" href="/Turlar/Yurtdisi">Yurt Dışı Turlar</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" href="#">Kıbrıs</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Mısır</a></li>
                <li class="nav-item"><a class="nav-link" href="#">Villa</a></li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Ulaşım</a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="#">Uçak Bileti</a></li>
                        <li><a class="dropdown-item" href="#">Otobüs Bileti</a></li>
                        <li><a class="dropdown-item" href="#">Transfer</a></li>
                    </ul>
                </li>
                <li class="nav-item"><a class="nav-link" href="#">Kampanyalar</a></li>
                <li class="nav-item"><a class="nav-link fw-bold" href="#">Erken Rezervasyon</a></li>
            </ul>
        </div>
    </div>
</nav>

<main class="fade-in">
    @RenderBody()
</main>

<footer class="footer">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-3 mb-4 mb-lg-0">
                <h4 class="fw-bold mb-3">ejderturizm</h4>
                <p class="text-muted small mb-4">Milyonlarca misafirimizin tatil hayalini gerçekleştirmenin mutluluğunu yaşıyoruz.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted fs-5"><i class="bi bi-facebook"></i></a>
                    <a href="#" class="text-muted fs-5"><i class="bi bi-twitter-x"></i></a>
                    <a href="#" class="text-muted fs-5"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="text-muted fs-5"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                <h5 class="footer-heading">Hakkımızda</h5>
                <a href="#" class="footer-link">Kurumsal</a>
                <a href="#" class="footer-link">Bize Ulaşın</a>
                <a href="#" class="footer-link">Acenteler</a>
                <a href="#" class="footer-link">İnsan Kaynakları</a>
            </div>
            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                <h5 class="footer-heading">Müşteri Hizmetleri</h5>
                <a href="#" class="footer-link">Sıkça Sorulan Sorular</a>
                <a href="#" class="footer-link">İptal ve İade Koşulları</a>
                <a href="#" class="footer-link">KVKK Aydınlatma Metni</a>
                <a href="#" class="footer-link">Gizlilik Sözleşmesi</a>
            </div>
            <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                <h5 class="footer-heading">Popüler Aramalar</h5>
                <a href="#" class="footer-link">Antalya Otelleri</a>
                <a href="#" class="footer-link">Kıbrıs Otelleri</a>
                <a href="#" class="footer-link">Uçak Bileti</a>
                <a href="#" class="footer-link">Yurt Dışı Turları</a>
            </div>
            <div class="col-lg-3 border-start ps-lg-4">
                <h5 class="footer-heading">Bizi Arayın</h5>
                <p class="fs-4 fw-bold mb-1">444 0 387</p>
                <p class="text-muted small">Her gün 09:00 - 24:00 arası</p>
            </div>
        </div>
        <div class="text-center pt-4 border-top">
            <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Ejder Turizm Seyahat Acentası Bütün Hakları Saklıdır.</p>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
</body>
</html>
