@model IEnumerable<Ejder.Domain.Products.Product>

@foreach (var p in Model)
{
    <div>
        <div><b>@p.Name</b></div>
        <div>@p.Days gün</div>
        <div>₺ @p.Price.ToString("N0")</div>

        <a asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">
            Detay
        </a>
    </div>
}