@model Ejder.Web.Public.Models.ProductDetailsVm

@{
    var p = Model.Product;
}

<h2>@p.Name</h2>

<div>
    <div><b>Süre:</b> @p.Days gün</div>
    <div><b>Fiyat:</b> ₺ @p.Price.ToString("N0")</div>
</div>

<hr />

<h3>Program</h3>

@if (Model.Program == null || !Model.Program.Any())
{
    <div>Program henüz eklenmemiş.</div>
}
else
{
    foreach (var d in Model.Program.OrderBy(x => x.DayNumber))
    {
        <div style="margin-bottom:10px;">
            <b>Gün @d.DayNumber:</b> @d.Title
            <div>@d.Description</div>
        </div>
    }
}

<hr />

<h3>Doküman</h3>

@if (Model.Document != null)
{
    <a href="@Model.Document.FilePath" target="_blank">
        @Model.Document.FileName
    </a>
}
else
{
    <div>PDF bulunamadı.</div>
}
