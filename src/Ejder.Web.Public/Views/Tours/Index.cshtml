@using Ejder.Application.Tours.Queries
@model PagedResult<Ejder.Application.Tours.DTOs.TourListDto>
@{
    string lang = ViewBag.Lang ?? "tr";
    ViewData["Title"] = lang == "tr" ? "Turlar" : "Tours";
    var categories = ViewBag.Categories as List<Ejder.Application.Categories.DTOs.CategoryDto>;
    Guid? activeCat = ViewBag.CategoryId;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = 6;
    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / pageSize);
}

<div class="container py-5">
    <div class="row">
        <!-- Filters Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 100px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">@(lang == "tr" ? "Filtreler" : "Filters")</h5>
                    
                    <div class="mb-4">
                        <label class="form-label fw-semibold mb-3">@(lang == "tr" ? "Kategoriler" : "Categories")</label>
                        <div class="list-group list-group-flush">
                            <a href="/@lang/tours" class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(activeCat == null ? "fw-bold text-primary" : "")">
                                <span><i class="bi bi-grid-fill me-2"></i> @(lang == "tr" ? "Tümü" : "All")</span>
                            </a>
                            @if (categories != null)
                            {
                                foreach (var cat in categories)
                                {
                                    <a href="/@lang/tours?categoryId=@cat.Id" class="list-group-item list-group-item-action border-0 px-0 d-flex justify-content-between align-items-center @(activeCat == cat.Id ? "fw-bold text-primary" : "")">
                                        <span><i class="bi bi-tag-fill me-2 opacity-50"></i> @(lang == "tr" ? cat.Name_TR : cat.Name_EN)</span>
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tours Grid -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="fw-bold mb-0">
                    @if (activeCat != null && categories != null)
                    {
                        var currentCat = categories.FirstOrDefault(c => c.Id == activeCat);
                        @(lang == "tr" ? currentCat?.Name_TR : currentCat?.Name_EN)
                    }
                    else
                    {
                        @(lang == "tr" ? "Tüm Turlar" : "All Tours")
                    }
                    <span class="text-muted fw-normal fs-6 ms-2">(@Model.TotalCount @(lang == "tr" ? "sonuç" : "results"))</span>
                </h4>
            </div>

            @if (!Model.Items.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search display-1 text-muted opacity-25"></i>
                    <p class="mt-3 text-muted">@(lang == "tr" ? "Aradığınız kriterlere uygun tur bulunamadı." : "No tours found matching your criteria.")</p>
                    <a href="/@lang/tours" class="btn btn-primary rounded-pill px-4 mt-2">@(lang == "tr" ? "Tüm Turları Gör" : "See All Tours")</a>
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (var tour in Model.Items)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden tour-card translate-y-hover">
                                <div class="position-relative">
                                    <img src="@(string.IsNullOrEmpty(tour.ImageUrl) ? "/images/placeholder-tour.jpg" : tour.ImageUrl)" class="card-img-top" style="height: 240px; object-fit: cover;" alt="@(lang == "tr" ? tour.Name_TR : tour.Name_EN)">
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-white text-dark shadow-sm rounded-pill px-3 py-2 fw-bold">
                                            @(lang == "tr" ? tour.CategoryName_TR : tour.CategoryName_EN)
                                        </span>
                                    </div>
                                    @if (tour.DiscountedPrice.HasValue)
                                    {
                                        <div class="position-absolute bottom-0 start-0 m-3">
                                            <span class="badge bg-danger shadow-sm rounded-pill px-3 py-2 fw-bold">
                                                %@(Math.Round((1 - (double)tour.DiscountedPrice.Value / (double)tour.Price) * 100)) @(lang == "tr" ? "İNDİRİM" : "OFF")
                                            </span>
                                        </div>
                                    }
                                </div>
                                <div class="card-body p-4">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i> @tour.StartDate.ToString("dd MMM") - @tour.EndDate.ToString("dd MMM yyyy")</span>
                                    </div>
                                    <h5 class="card-title fw-bold mb-3">@(lang == "tr" ? tour.Name_TR : tour.Name_EN)</h5>
                                    <p class="card-text text-muted small line-clamp-2 mb-4">@(lang == "tr" ? tour.ShortDescription_TR : tour.ShortDescription_EN)</p>
                                    
                                    <div class="d-flex justify-content-between align-items-end mt-auto">
                                        <div>
                                            @if (tour.DiscountedPrice.HasValue)
                                            {
                                                <div class="text-muted text-decoration-line-through small mb-0">@tour.Price.ToString("C0")</div>
                                                <div class="text-primary fw-extrabold fs-4">@tour.DiscountedPrice.Value.ToString("C0")</div>
                                            }
                                            else
                                            {
                                                <div class="text-primary fw-extrabold fs-4">@tour.Price.ToString("C0")</div>
                                            }
                                        </div>
                                        <a href="/@lang/tours/@tour.Id" class="btn btn-outline-primary rounded-pill px-4 fw-bold">@(lang == "tr" ? "İncele" : "Explore")</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center gap-2">
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link rounded-circle border-0 @(i == currentPage ? "shadow-sm" : "")" href="/@lang/tours?page=@i@(activeCat.HasValue ? "&categoryId=" + activeCat : "")">@i</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

<style>
    .translate-y-hover {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .translate-y-hover:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
    }
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .fw-extrabold { font-weight: 800; }
    .page-link { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; }
</style>
