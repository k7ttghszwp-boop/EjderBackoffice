<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EJDER OPS</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link href="~/css/ejder-ui.css" rel="stylesheet" asp-append-version="true">
    
    <style>
        :root {
            --bg-primary: #000;
            --text-primary: #fff;
            --border: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            font-family: 'Outfit', sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .navbar {
            background: rgba(0, 0, 0, 0.8) !important;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            padding: 1.2rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            letter-spacing: -1px;
            text-transform: uppercase;
        }

        .nav-link {
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 0.75rem;
            font-weight: 600;
            opacity: 0.6;
            transition: opacity 0.3s;
        }

        .nav-link:hover {
            opacity: 1;
        }

        .card {
            background: #0a0a0a;
            border: 1px solid var(--border);
            border-radius: 0;
        }

        .fade-in {
            animation: fadeIn 0.8s ease forwards;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .footer {
            border-top: 1px solid var(--border);
            background: #050505;
        }

        .btn-luxury {
            background: white;
            color: black;
            border: none;
            border-radius: 0;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 0.75rem;
            padding: 8px 16px;
        }
    </style>
</head>
<body class="bg-black">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand" href="/">EJDER <span class="fw-light opacity-50">OPS</span></a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav gap-4">
                        <li class="nav-item">
                            <a class="nav-link" href="/Leads">Pipeline</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Privacy">System Logs</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container-fluid px-4 my-5 fade-in">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer py-4 mt-auto">
        <div class="container-fluid px-4 text-center small text-muted text-uppercase tracking-widest" style="font-size: 10px;">
            &copy; @DateTime.Now.Year EJDER OPS CENTER // VERSION 2.0_BETA
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
